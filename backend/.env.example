# ==============================================================================
# ExpenseFlow Backend Environment Configuration Template
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- Application Settings ---
APP_NAME=ExpenseFlow
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SEED_ON_STARTUP=true

# --- Database Connection ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expenseflow

# --- CORS & Network ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- Frontend Application ---
FRONTEND_URL=http://localhost:3000

# --- JWT Authentication ---
# Secret key used for signing JWT access tokens (use a strong random 256-bit string in production)
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=60

# --- Cookie Security Settings ---
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# --- Google OAuth 2.0 (Optional / Social Sign-In) ---
# Retrieve from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- SMTP Email Configuration (Password Recovery & Welcome Emails) ---
# OPTION 1: Resend SMTP (Recommended for Production / Cloud Deployment)
# Retrieve your API key (starts with re_) from https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=ExpenseFlow
SMTP_TLS=true

# OPTION 2: Gmail SMTP (Alternative for Local Development)
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-letter App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_letter_gmail_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME=ExpenseFlow
# SMTP_TLS=true

# --- AI Financial Recommendations & Intelligence (Multi-Provider Support) ---
# Set AI_ENABLED=false to disable AI features.
AI_ENABLED=true

# Choose AI Provider: "gemini" | "openai" | "claude"
AI_PROVIDER=gemini

# Provider API Keys:
# - For Google Gemini: Obtain from https://aistudio.google.com/app/apikey
# - For OpenAI (ChatGPT): Obtain from https://platform.openai.com/api-keys
# - For Anthropic (Claude): Obtain from https://console.anthropic.com/
AI_API_KEY=your_ai_provider_api_key_here

# Model identifier (compatible with selected provider)
# Gemini default: gemini-1.5-flash (or gemini-2.0-flash)
# OpenAI default: gpt-4o-mini
# Claude default: claude-3-5-haiku-20241022
AI_MODEL=gemini-1.5-flash

# Optional custom base URL (useful for OpenRouter, Groq, or local Ollama)
# AI_BASE_URL=https://openrouter.ai/api/v1

# In-memory recommendation cache duration in hours
AI_CACHE_HOURS=6